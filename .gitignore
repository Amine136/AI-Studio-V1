# =========================
# Python (Backend)
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.env
*.egg-info/
dist/
build/

# Generated images (optional: remove if you want to commit samples)
backend/generated_images/*
!backend/generated_images/.gitkeep
backend/uploaded_images/*
!backend/uploaded_images/.gitkeep
# Customer payment receipts. Never commit these: they are financial documents
# belonging to real buyers.
backend/payment_proofs/*
!backend/payment_proofs/.gitkeep
backend/app/data/*.sqlite3
backend/app/data/model_catalog.live.json

# =========================
# Node.js (Frontend)
# =========================
node_modules/
.next/
out/
.npm
*.tsbuildinfo

# =========================
# IDE & OS
# =========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =========================
# Logs & Debug
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Environment & Secrets
# =========================
.env
.env.local
.env.*.local
*.pem
backend/.secrets/

# Secret backups and per-environment runtime state — never track
backend/.env.bak-token-*
backend/.env.*
backend/.env.bak*

backend/app/data/model_visibility.json
