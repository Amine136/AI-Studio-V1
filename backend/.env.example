# Vibecraft backend — environment template
#
# Copy to backend/.env for local development and fill in real values.
# NEVER commit backend/.env. No value in this file is a real credential.
#
# In production these are Cloud Run env vars on service `vibecraft`
# (project free-496600, region europe-west3). Update them with:
#   gcloud run services update vibecraft --region=europe-west3 \
#     --project=free-496600 --update-env-vars="KEY=value"
# Use --update-env-vars, never --set-env-vars (the latter wipes the rest).

# ---------------------------------------------------------------
# Required — the app raises on startup without these
# ---------------------------------------------------------------

# Neon PostgreSQL. Use the -pooler endpoint. postgresql:// is rewritten
# to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Firebase project used to verify user ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---------------------------------------------------------------
# Cloudflare R2 media storage
# Without these, get_r2_client() returns None and uploads degrade
# instead of raising — so a typo here fails quietly. Verify uploads work.
# ---------------------------------------------------------------
R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vibecraft-media
R2_PUBLIC_URL=https://pub-EXAMPLE.r2.dev

# ---------------------------------------------------------------
# AKM gateway (AI provider proxy)
# ---------------------------------------------------------------
APIKEYMANAGER_URL=https://akm-gateway-EXAMPLE.europe-west3.run.app
APIKEYMANAGER_TOKEN=
APIKEYMANAGER_TIMEOUT=120
# Shared secret AKM signs catalog-update webhooks with.
CATALOG_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Admin sessions. Also the fallback signing key for unsubscribe links
# and Discord payment proofs, so rotating it invalidates those too.
# ---------------------------------------------------------------
ADMIN_SESSION_SECRET=
# Guards the internal cleanup sweep endpoint.
INTERNAL_SWEEP_SECRET=

# ---------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Vibecraft
# Leave false in production; allows sending from non-prod environments.
EMAIL_ALLOW_NONPROD=false

# ---------------------------------------------------------------
# Discord (order notifications + slash-command interactions)
# ---------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ID=

# ---------------------------------------------------------------
# Dodo Payments
# ---------------------------------------------------------------
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=live_mode
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_ULTRA=

# ---------------------------------------------------------------
# Meta Conversions API (optional, off when empty)
# ---------------------------------------------------------------
META_CAPI_ACCESS_TOKEN=

# ---------------------------------------------------------------
# App / networking
# ---------------------------------------------------------------
APP_ENV=production
# Absolute base URL this backend is reachable at; used to build file URLs.
PUBLIC_BACKEND_BASE_URL=https://vibecraft-EXAMPLE.a.run.app
ALLOWED_ORIGINS=https://vibecraft.example.com,https://prodx.example.com

# ---------------------------------------------------------------
# Database pool tuning (defaults shown)
# ---------------------------------------------------------------
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT=10
DATABASE_ECHO=false
